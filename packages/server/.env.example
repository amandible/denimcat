# Copy this file to .env and fill in your own Neon connection string.
# Without it, the server falls back to in-memory-only room storage.
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Optional: restrict Socket.io CORS to your deployed client's origin.
# Defaults to "*" (any origin) if unset — fine for local dev.
# CLIENT_ORIGIN=https://your-client.vercel.app

# Optional: port the server listens on. Defaults to 4000.
# PORT=4000

# Optional: real email sending (async-play turn notifications, and magic-link
# sign-in). Without both set, emails just get logged to the console instead
# of actually sent — fine for local dev.
# RESEND_API_KEY=re_...
# RESEND_FROM=denimcat <noreply@yourdomain.com>

# Optional: canonical base URL used to build clickable links in emails (a
# turn-notification reconnect link, or a magic-link sign-in link). Omit to
# send those emails without a clickable link.
# APP_BASE_URL=https://denimcat.ancepp-glos.com

# Optional: where "a new account was just created" notifications go for
# magic-link sign-in (see @denimcat/platform's authService). Signup is open
# to anyone — this is how you stay aware of who's joining. Omit to skip
# that notification entirely.
# OWNER_EMAIL=you@example.com
