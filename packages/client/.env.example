# Copy this file to .env.local for local overrides, or set it as a Vercel
# environment variable for the deployed build.
# Defaults to http://localhost:4000 if unset.
VITE_SERVER_URL=https://your-server.fly.dev

# SITE_PASSWORD is read by middleware.ts (Vercel Edge Middleware), not by
# the app itself — it's not a VITE_ var and is never bundled into client
# JS. Set it in the Vercel dashboard (Project Settings > Environment
# Variables), not here. Only needed locally if testing via `vercel dev`
# (pull with `vercel env pull .env.local`); plain `npm run dev` never
# runs middleware.ts, so it's not required for normal local development.
