    "test:engine-mint-condition": "npm run test -w @denimcat/engine-mint-condition",
    "test:engine-love-triangles": "npm run test -w @denimcat/engine-love-triangles",
    "test:engine-tashkalar": "npm run test -w @denimcat/engine-tashkalar",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.1"
  }
}
