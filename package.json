{
  "name": "denimcat",
  "private": true,
  "workspaces": [
    "packages/*",
    "private-games/other-games/engine-hyperbloom",
    "private-games/other-games/engine-tashkalar"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
